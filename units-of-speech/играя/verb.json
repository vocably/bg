{"transcript":"iˈɡra.jɐ","exists":true,"definitions":["Извършвам дейност за забавление или отдих.","Участвам в игра или спорт.","Изпълнявам роля в театрална постановка или филм.","Свиря на музикален инструмент."],"examples":["Децата играят в парка.","Той играе футбол всяка събота.","Актрисата играе главна роля.","Тя играе на пиано много добре."],"lemma":"играя","lemmaPos":"verb","synonyms":["забавлявам се","участвам","изпълнявам"],"number":"singular","tense":"present","source":"играя"}